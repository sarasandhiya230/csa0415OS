#include <stdio.h>
int main() {
    int pages[] = {1, 2, 3, 4, 1, 2, 5, 1, 2, 3, 4, 5};
    int frames[3] = {-1, -1, -1};
    int n = 12, faults = 0, pos = 0;
    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < 3; j++)
            if (frames[j] == pages[i])
                found = 1;
        if (!found) {
            frames[pos] = pages[i];
            pos = (pos + 1) % 3;
            faults++;
        }
    }
    printf("Total Page Faults = %d", faults);
    return 0;
}
