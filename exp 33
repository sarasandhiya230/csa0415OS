#include <stdio.h>
int main() {
    int p[] = {1, 2, 3, 4, 1, 2, 5};
    int f[3] = {-1, -1, -1};
    int n = 7, faults = 0;
    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < 3; j++)
            if (f[j] == p[i])
                found = 1;
        if (!found) {
            int pos = 0, far = -1;
            for (int j = 0; j < 3; j++) {
                int k;
                for (k = i + 1; k < n; k++)
                    if (f[j] == p[k])
                        break;
                if (k > far) {
                    far = k;
                    pos = j;
                }
            }
            f[pos] = p[i];
            faults++;
        }
    }
    printf("Page Faults = %d", faults);
    return 0;
}
