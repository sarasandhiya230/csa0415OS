#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
int main() {
    int pid = fork();
    if (pid == 0) {
        printf("Child Process Created\n");
    } else if (pid > 0) {
        wait(NULL);
        printf("Parent Process Executed\n");
    } else {
        printf("Fork Failed\n");
    }
    return 0;
}
