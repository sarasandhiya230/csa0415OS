#include <stdio.h>
int main(void) {
    int n,i,j,bt[20],pr[20],p[20],wt[20],tat[20],t=0,tmp;
    float aw=0,at=0;
    printf("Enter number of processes: "); scanf("%d",&n);
    for(i=0;i<n;i++){p[i]=i+1;printf("Burst time and priority for P%d: ",i+1);scanf("%d%d",&bt[i],&pr[i]);}
    for(i=0;i<n-1;i++) for(j=i+1;j<n;j++) if(pr[j]<pr[i]){
        tmp=pr[i];pr[i]=pr[j];pr[j]=tmp; tmp=bt[i];bt[i]=bt[j];bt[j]=tmp; tmp=p[i];p[i]=p[j];p[j]=tmp;
    }
    for(i=0;i<n;i++){wt[i]=t;tat[i]=t+bt[i];t+=bt[i];aw+=wt[i];at+=tat[i];}
    printf("Process\\tBT\\tPriority\\tWT\\tTAT\n");
    for(i=0;i<n;i++) printf("P%d\\t%d\\t%d\\t\\t%d\\t%d\n",p[i],bt[i],pr[i],wt[i],tat[i]);
    printf("Average WT = %.2f\\nAverage TAT = %.2f\n",aw/n,at/n);
    return 0;
}
