#include <stdio.h>
int main(void) {
    int n, i, bt[20], wt[20], tat[20], time = 0;
    float aw = 0, at = 0;
    printf("Enter number of processes: "); scanf("%d", &n);
    for (i=0;i<n;i++) { printf("Burst time P%d: ",i+1); scanf("%d",&bt[i]); }
    for (i=0;i<n;i++) {
        wt[i]=time; tat[i]=wt[i]+bt[i]; time+=bt[i];
        aw+=wt[i]; at+=tat[i];
    }
    printf("Process\\tBT\\tWT\\tTAT\n");
    for (i=0;i<n;i++) printf("P%d\\t%d\\t%d\\t%d\n",i+1,bt[i],wt[i],tat[i]);
    printf("Average WT = %.2f\\nAverage TAT = %.2f\n",aw/n,at/n);
    return 0;
}
