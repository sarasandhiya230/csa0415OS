#include <stdio.h>
int main(void) {
    int n,i,q,t=0,bt[20],rem[20],wt[20]={0},tat[20],done;
    float aw=0,at=0;
    printf("Enter number of processes: "); scanf("%d",&n);
    for(i=0;i<n;i++){printf("Burst time P%d: ",i+1);scanf("%d",&bt[i]);rem[i]=bt[i];}
    printf("Enter time quantum: "); scanf("%d",&q);
    if(q<=0){printf("Quantum must be positive.\n");return 1;}
    do {done=1; for(i=0;i<n;i++) if(rem[i]>0){
        done=0; if(rem[i]>q){t+=q;rem[i]-=q;} else {t+=rem[i];rem[i]=0;tat[i]=t;wt[i]=tat[i]-bt[i];}
    }} while(!done);
    printf("Process\\tBT\\tWT\\tTAT\n");
    for(i=0;i<n;i++){printf("P%d\\t%d\\t%d\\t%d\n",i+1,bt[i],wt[i],tat[i]);aw+=wt[i];at+=tat[i];}
    printf("Average WT = %.2f\\nAverage TAT = %.2f\n",aw/n,at/n);
    return 0;
}
