#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
int main(void) {
    pid_t p = fork();
    if (p < 0) { perror("fork"); return 1; }
    if (p == 0)
        printf("Child process: PID = %d, Parent PID = %d\n", getpid(), getppid());
    else
        printf("Parent process: PID = %d, Child PID = %d\n", getpid(), p);
    return 0;
}
