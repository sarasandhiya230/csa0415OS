#include <stdio.h>
int main() {
    int buffer[5], item = 0;
    int choice, count = 0;
    while (1) {
        printf("\n1. Produce\n2. Consume\n3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);
        if (choice == 1) {
            if (count == 5)
                printf("Buffer Full\n");
            else {
                buffer[count++] = ++item;
                printf("Produced Item: %d\n", item);
            }
        }
        else if (choice == 2) {
            if (count == 0)
                printf("Buffer Empty\n");
            else {
                printf("Consumed Item: %d\n", buffer[0]);
                for (int i = 0; i < count - 1; i++)
                    buffer[i] = buffer[i + 1];
                count--;
            }
        }
        else
            break;
    }
    return 0;
}
