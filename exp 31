#include <stdio.h>
int main() {
    int p[] = {1, 2, 3, 4, 1, 2, 5};
    int f[3] = {-1, -1, -1};
    int faults = 0, pos = 0;
    for (int i = 0; i < 7; i++) {
        int found = 0;
        for (int j = 0; j < 3; j++)
            if (f[j] == p[i])
                found = 1;
        if (!found) {
            f[pos] = p[i];
            pos = (pos + 1) % 3;
            faults++;
        }
    }
    printf("Page Faults = %d", faults);
    return 0;
}
