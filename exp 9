#include <stdio.h>
#include <sys/mman.h>
#include <sys/wait.h>
#include <unistd.h>
#include <string.h>
int main(void) 
{
    char *mem = mmap(NULL, 4096, PROT_READ|PROT_WRITE,
                     MAP_SHARED|MAP_ANONYMOUS, -1, 0);
    if(mem==MAP_FAILED){perror("mmap");return 1;}
    if(fork()==0){strcpy(mem,"Hello from child using shared memory");_exit(0);}
    wait(NULL); printf("Parent reads: %s\n",mem);
    munmap(mem,4096); return 0;
}
