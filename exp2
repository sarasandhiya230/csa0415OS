#include <stdio.h>
int main(void) {
    FILE *src, *dest;
    int ch;
    src = fopen("input.txt", "r");
    if (src == NULL) { printf("Cannot open input.txt\n"); return 1; }
    dest = fopen("output.txt", "w");
    if (dest == NULL) { fclose(src); printf("Cannot create output.txt\n"); return 1; }
    while ((ch = fgetc(src)) != EOF) fputc(ch, dest);
    fclose(src); fclose(dest);
    printf("File copied successfully.\n");
    return 0;
}
