#include <stdio.h>
int main() {
    int p[] = {1, 2, 3, 1, 4, 5};
    int f[3] = {-1, -1, -1};
    int t[3] = {0}, faults = 0;
    for (int i = 0; i < 6; i++) {
        int k = -1;
        for (int j = 0; j < 3; j++)
            if (f[j] == p[i])
                k = j;
        if (k == -) {
            k = 0;
            for (int j = 1; j < 3; j++)
                if (t[j] < t[k])
                    k = j;
            f[k] = p[i];
            faults++;
        }
        t[k] = i + 1;
    }
    printf("Page Faults = %d", faults);
    return 0;
}
