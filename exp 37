#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[] = {98, 183, 37, 122, 14, 124, 65, 67};
    int head = 53, total = 0;
    printf("Disk Head Movement:\n");
    for (int i = 0; i < 8; i++) {
        printf("%d -> ", head);
        total += abs(a[i] - head);
        head = a[i];
    }
    printf("%d\n", head);
    printf("Total Head Movement = %d", total);
    return 0;
}
