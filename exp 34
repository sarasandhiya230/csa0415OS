#include <stdio.h>
int main() {
    int block[] = {100, 500, 200, 300, 600};
    int process[] = {212, 417, 112, 426};
    int n = 5, m = 4;
    for (int i = 0; i < m; i++) {
        int j;
        for (j = 0; j < n; j++) {
            if (block[j] >= process[i]) {
                printf("Process %d allocated to Block %d\n",
                       process[i], j + 1);
                block[j] -= process[i];
                break;
            }
        }
        if (j == n)
            printf("Process %d Not Allocated\n", process[i]);
    }
    return 0;
}
