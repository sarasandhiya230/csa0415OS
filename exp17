#include <stdio.h>
int main(void){
    int n,m,i,j,alloc[10][10],max[10][10],need[10][10],avail[10],finish[10]={0},seq[10],work[10],count=0,found;
    printf("Processes and resources: ");scanf("%d%d",&n,&m);
    printf("Enter allocation matrix:\n");
    for(i=0;i<n;i++)for(j=0;j<m;j++)scanf("%d",&alloc[i][j]);
    printf("Enter maximum matrix:\n");
    for(i=0;i<n;i++)for(j=0;j<m;j++){scanf("%d",&max[i][j]);need[i][j]=max[i][j]-alloc[i][j];}
    printf("Enter available resources:\n");for(j=0;j<m;j++){scanf("%d",&avail[j]);work[j]=avail[j];}
    while(count<n){found=0;for(i=0;i<n;i++)if(!finish[i]){
        for(j=0;j<m;j++)if(need[i][j]>work[j])break;
        if(j==m){for(j=0;j<m;j++)work[j]+=alloc[i][j];seq[count++]=i;finish[i]=1;found=1;}
    }if(!found)break;}
    if(count==n){printf("Safe sequence: ");for(i=0;i<n;i++)printf("P%d ",seq[i]);printf("\n");}
    else printf("System is not in a safe state.\n");
    return 0;
}
