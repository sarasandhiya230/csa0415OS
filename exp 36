#include <stdio.h>
int main() {
    int n, blocks[20];
    printf("Enter number of blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &blocks[i]);
    printf("\nLinked File Allocation:\n");
    for (int i = 0; i < n; i++) {
        if (i < n - 1)
            printf("%d -> ", blocks[i]);
        else
            printf("%d -> NULL", blocks[i]);
    }
    return 0;
}
