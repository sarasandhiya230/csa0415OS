#include <stdio.h>
int main(void) {
    int n,i,t=0,done=0,at[20],bt[20],rem[20],ct[20],best;
    float aw=0,aa=0;
    printf("Enter number of processes: "); scanf("%d",&n);
    for(i=0;i<n;i++){printf("Arrival and burst time for P%d: ",i+1);scanf("%d%d",&at[i],&bt[i]);rem[i]=bt[i];}
    while(done<n){
        best=-1;
        for(i=0;i<n;i++) if(at[i]<=t && rem[i]>0 && (best==-1 || rem[i]<rem[best])) best=i;
        if(best==-1){t++;continue;}
        rem[best]--; t++;
        if(rem[best]==0){ct[best]=t;done++;}
    }
    printf("Process\\tWT\\tTAT\n");
    for(i=0;i<n;i++){int tat=ct[i]-at[i],wt=tat-bt[i];printf("P%d\\t%d\\t%d\n",i+1,wt,tat);aw+=wt;aa+=tat;}
    printf("Average WT = %.2f\\nAverage TAT = %.2f\n",aw/n,aa/n);
    return 0;
}
