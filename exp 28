#include <stdio.h>
#include <string.h>
int main() {
    char text[100][100], key[30];
    int n;
    printf("Enter number of lines: ");
    scanf("%d", &n);
    getchar();
    printf("Enter lines:\n");
    for (int i = 0; i < n; i++)
        fgets(text[i], 100, stdin);
    printf("Enter search word: ");
    scanf("%s", key);
    printf("Matching Lines:\n");
    for (int i = 0; i < n; i++)
        if (strstr(text[i], key))
            printf("%s", text[i]);
    return 0;
}
